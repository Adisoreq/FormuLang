{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FormuLang conformance test file",
  "type": "object",
  "required": ["standards", "cases"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "description": { "type": "string" },
    "standards": {
      "description": "Standards required by every case of the file, e.g. [\"core-1.0\"].",
      "$ref": "#/definitions/standards"
    },
    "defaults": {
      "description": "Values used by every case that does not define them.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "context": { "$ref": "#/definitions/context" },
        "environment": { "$ref": "#/definitions/environment" },
        "registry": { "$ref": "#/definitions/registry" }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/case" }
    }
  },
  "definitions": {
    "standards": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*-\\d+\\.\\d+$" }
    },
    "formula": {
      "description": "Formula text, or its lines (joined with a new line).",
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "value": {
      "description": "FormuLang value in JSON form: Number -> number, Text -> string, Boolean -> boolean, Null -> null, Array -> array, Object -> object. An extended type is an object with the \"$type\" key, e.g. { \"$type\": \"Stock.Candle\", ... }."
    },
    "error": {
      "type": "object",
      "required": ["code"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "SUCCESS", "CUSTOM_ERROR", "SYNTAX_ERROR", "OPERATION_ERROR", "TYPE_ERROR",
            "UNKNOWN_SYMBOL_ERROR", "ARGUMENT_ERROR", "INVALID_INDEX_ERROR", "INVALID_KEY_ERROR",
            "INVALID_IDENTIFIER_ERROR", "ENVIRONMENT_ERROR", "NOT_SUPPORTED_ERROR", "UNDEFINED_ERROR"
          ]
        },
        "message": {
          "description": "Exact detail text. Only checked when present.",
          "type": "string"
        }
      }
    },
    "candle": {
      "type": "object",
      "required": ["open", "high", "low", "close"],
      "additionalProperties": false,
      "properties": {
        "open": { "type": "number" },
        "high": { "type": "number" },
        "low": { "type": "number" },
        "close": { "type": "number" },
        "volume": { "type": ["number", "null"] },
        "time": { "type": ["number", "null"] }
      }
    },
    "frame": {
      "type": "object",
      "required": ["time_s", "dtime_s"],
      "additionalProperties": false,
      "properties": {
        "time_s": { "type": "number", "minimum": 0 },
        "dtime_s": { "type": "number", "minimum": 0 },
        "now": { "type": "integer" }
      }
    },
    "context": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["Default", "Iteration", "Time", "Stock", "Indicator", "Pattern", "Strategy"]
        },
        "n": {
          "description": "Iteration: number of iterations.",
          "type": "integer",
          "minimum": 0
        },
        "frames": {
          "description": "Time: the frames, in order.",
          "type": "array",
          "items": { "$ref": "#/definitions/frame" }
        },
        "candles": {
          "description": "Stock contexts: the CANDLES constant, from the oldest to the newest.",
          "type": "array",
          "items": { "$ref": "#/definitions/candle" }
        },
        "parameters": {
          "description": "Indicator, Pattern and Strategy (stock-1.2): the PARAMETERS constant. A Strategy without it has PARAMETERS = { }.",
          "type": "object"
        },
        "timeframe": {
          "description": "Stock contexts (stock-1.2): the TIMEFRAME constant (null when omitted).",
          "type": "string"
        },
        "timeframe_length": {
          "description": "Stock contexts (stock-1.2): the length of the main timeframe in milliseconds, needed with timeframes.",
          "type": "integer",
          "minimum": 1
        },
        "instrument": {
          "description": "Stock contexts (stock-1.2): the INSTRUMENT constant (null when omitted).",
          "type": "string"
        },
        "timeframes": {
          "description": "Stock contexts (stock-1.2): the candles of other timeframes provided by the host application, by name. A timeframe that is not listed is not provided.",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["length", "candles"],
            "additionalProperties": false,
            "properties": {
              "length": { "description": "Length of a candle of the timeframe in milliseconds.", "type": "integer", "minimum": 1 },
              "candles": { "type": "array", "items": { "$ref": "#/definitions/candle" } }
            }
          }
        },
        "source": {
          "description": "Indicator: the SOURCE constant (CLOSE when omitted).",
          "type": "array",
          "items": { "type": ["number", "null"] }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "constants": {
          "description": "Environment constants that replace the initial values, e.g. { \"NOW\": 0 }.",
          "type": "object"
        },
        "variables": {
          "description": "Environment variables that replace the initial values, e.g. { \"array_indexing\": 1 }.",
          "type": "object"
        },
        "omit": {
          "description": "Names of environment elements removed before the execution (to test the environment checks).",
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "definition": {
      "type": "object",
      "required": ["id", "formula"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z_]\\w*$" },
        "formula": { "$ref": "#/definitions/formula" },
        "parameters": { "type": "object" }
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "indicators": { "type": "array", "items": { "$ref": "#/definitions/definition" } },
        "patterns": { "type": "array", "items": { "$ref": "#/definitions/definition" } }
      }
    },
    "warning": {
      "type": "string",
      "enum": ["UNUSED_VALUE", "CONTINUED_LINE", "METADATA_TYPE", "METADATA_CONTEXT"]
    },
    "expected": {
      "description": "Exactly one of: result, results, error, errors, metadata, warnings, definition, invalid, parameters, problems, outputs, matches, signals.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "result": {
          "description": "Result of a single execution.",
          "$ref": "#/definitions/value"
        },
        "results": {
          "description": "Results of every iteration or frame, in order. An element can be { \"$error\": \"<CODE>\" }.",
          "type": "array"
        },
        "error": {
          "description": "The execution results in this error.",
          "$ref": "#/definitions/error"
        },
        "errors": {
          "description": "The validation returns exactly these errors, in this order.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/error" }
        },
        "metadata": {
          "description": "core-1.2: the metadata reading succeeds and gives this Object ({ } without a metadata block).",
          "type": "object"
        },
        "warnings": {
          "description": "core-1.2: the preparation succeeds and gives exactly these warnings (codes), in the order of their positions. An empty array means no warnings.",
          "type": "array",
          "items": { "$ref": "#/definitions/warning" }
        },
        "definition": {
          "description": "Formula models: the formula is a valid definition with these properties (parameters, outputs and checks as their keys, null for none).",
          "type": "object",
          "required": ["kind", "id", "name", "category", "parameters", "outputs", "checks"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["Indicator", "Pattern", "Strategy"] },
            "id": { "type": "string" },
            "name": { "type": "string" },
            "category": { "type": ["string", "null"] },
            "parameters": { "type": "array", "items": { "type": "string" } },
            "outputs": { "type": ["array", "null"], "items": { "type": "string" } },
            "checks": { "type": ["array", "null"], "items": { "type": "string" } }
          }
        },
        "invalid": {
          "description": "Formula models: the formula is not a valid definition, for this reason.",
          "enum": ["ERROR", "METADATA_TYPE", "ID", "CONTEXT"]
        },
        "parameters": {
          "description": "Formula models: the normalization of `given` gives this Object.",
          "type": "object"
        },
        "problems": {
          "description": "Formula models: the normalization of `given` gives exactly these problems, in order.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["key", "code"],
            "additionalProperties": false,
            "properties": {
              "key": { "type": "string" },
              "code": { "enum": ["UNKNOWN", "MISSING", "TYPE", "MIN", "MAX", "OPTION"] }
            }
          }
        },
        "outputs": {
          "description": "Formula models: the run of an indicator instance gives these outputs (the order of the keys is checked).",
          "type": "object",
          "additionalProperties": { "type": "array" }
        },
        "matches": {
          "description": "Formula models: the run of a pattern instance gives this series.",
          "type": "array",
          "items": { "type": "boolean" }
        },
        "signals": {
          "description": "Formula models: the run of a strategy instance gives these signals. A missing reason or checks means none, a missing extra means { }.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["index", "time", "signal"],
            "additionalProperties": false,
            "properties": {
              "index": { "type": "integer", "minimum": 0 },
              "time": { "type": ["number", "null"] },
              "signal": { "type": "number", "minimum": -1, "maximum": 1 },
              "reason": { "type": "string" },
              "checks": { "type": "object", "additionalProperties": { "type": "boolean" } },
              "extra": { "type": "object" }
            }
          }
        }
      }
    },
    "case": {
      "type": "object",
      "required": ["id", "formula", "expected"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Unique identifier, e.g. core.functions.FORMAT.001.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[A-Za-z0-9_]+)+$"
        },
        "description": { "type": "string" },
        "standards": {
          "description": "Additional standards required by this case.",
          "$ref": "#/definitions/standards"
        },
        "spec": {
          "description": "Relative link to the part of the specification that the case checks.",
          "type": "string"
        },
        "context": { "$ref": "#/definitions/context" },
        "environment": { "$ref": "#/definitions/environment" },
        "registry": { "$ref": "#/definitions/registry" },
        "formula": { "$ref": "#/definitions/formula" },
        "given": {
          "description": "Formula models: the parameter values given by the host application, for parameters, problems and the runs ({ } by default).",
          "type": "object"
        },
        "expected": { "$ref": "#/definitions/expected" }
      }
    }
  }
}
