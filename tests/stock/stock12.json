{
  "$schema": "../schema.json",
  "description": "Stock 1.2: TIMEFRAME, INSTRUMENT, PARAMETERS in a strategy, the signal object, SCORE, the series functions and other timeframes. Main chart: 8 candles of 15 minutes from the time 0, CLOSE = [1, 2, 3, 4, 5, 6, 7, 8]; timeframe 1h: 2 candles with the closes 4 and 8.",
  "standards": ["core-1.2", "stock-1.2"],
  "defaults": {"context": {"type": "Stock", "candles": [{"open": 0.5, "high": 1.5, "low": 0, "close": 1, "time": 0}, {"open": 1.5, "high": 2.5, "low": 1, "close": 2, "time": 900000}, {"open": 2.5, "high": 3.5, "low": 2, "close": 3, "time": 1800000}, {"open": 3.5, "high": 4.5, "low": 3, "close": 4, "time": 2700000}, {"open": 4.5, "high": 5.5, "low": 4, "close": 5, "time": 3600000}, {"open": 5.5, "high": 6.5, "low": 5, "close": 6, "time": 4500000}, {"open": 6.5, "high": 7.5, "low": 6, "close": 7, "time": 5400000}, {"open": 7.5, "high": 8.5, "low": 7, "close": 8, "time": 6300000}], "timeframe": "15m", "timeframe_length": 900000, "instrument": "EURUSD", "timeframes": {"1h": {"length": 3600000, "candles": [{"open": 0.5, "high": 4.5, "low": 0, "close": 4, "time": 0}, {"open": 4.5, "high": 8.5, "low": 4, "close": 8, "time": 3600000}]}}}, "registry": {"indicators": [{"id": "SMA2", "formula": "WINDOW(SOURCE, 2, AVG)"}, {"id": "PAIR", "formula": "{ a: SOURCE[I], b: SOURCE[I] * 2 }"}, {"id": "LATE", "formula": "IF(I == 0, null, { a: SOURCE[I] })"}], "patterns": [{"id": "UP", "formula": "CANDLES[I].close > CANDLES[I].open"}]}},
  "cases": [
    {"id": "stock.context.002", "description": "TIMEFRAME and INSTRUMENT", "spec": "../../docs/standards/stock/README.md#stock-context", "formula": "[TIMEFRAME, INSTRUMENT]", "expected": {"results": [["15m", "EURUSD"], ["15m", "EURUSD"], ["15m", "EURUSD"], ["15m", "EURUSD"], ["15m", "EURUSD"], ["15m", "EURUSD"], ["15m", "EURUSD"], ["15m", "EURUSD"]]}},
    {"id": "stock.context.003", "description": "TIMEFRAME and INSTRUMENT are null when the host application does not give them", "spec": "../../docs/standards/stock/README.md#stock-context", "context": {"type": "Stock", "candles": [{"open": 0.5, "high": 1.5, "low": 0, "close": 1, "time": 0}, {"open": 1.5, "high": 2.5, "low": 1, "close": 2, "time": 900000}]}, "formula": "[TIMEFRAME, INSTRUMENT]", "expected": {"results": [[null, null], [null, null]]}},
    {"id": "stock.context.004", "description": "PARAMETERS in the Strategy Context", "spec": "../../docs/standards/stock/README.md#strategy-context", "context": {"type": "Strategy", "candles": [{"open": 0.5, "high": 1.5, "low": 0, "close": 1, "time": 0}, {"open": 1.5, "high": 2.5, "low": 1, "close": 2, "time": 900000}], "parameters": {"period": 5}}, "formula": "PARAMETERS.period", "expected": {"results": [5, 5]}},
    {"id": "stock.context.005", "description": "PARAMETERS of a Strategy without parameters is { }", "spec": "../../docs/standards/stock/README.md#strategy-context", "context": {"type": "Strategy", "candles": [{"open": 0.5, "high": 1.5, "low": 0, "close": 1, "time": 0}, {"open": 1.5, "high": 2.5, "low": 1, "close": 2, "time": 900000}]}, "formula": "PARAMETERS", "expected": {"results": [{}, {}]}},
    {"id": "stock.strategy.001", "description": "A signal object with signal, reason, checks and a key of the host application", "spec": "../../docs/standards/stock/README.md#strategy-context", "context": {"type": "Strategy", "candles": [{"open": 0.5, "high": 1.5, "low": 0, "close": 1, "time": 0}, {"open": 1.5, "high": 2.5, "low": 1, "close": 2, "time": 900000}]}, "formula": "{ signal: BUY, reason: \"r\", checks: { a: true, b: false }, stop: 1.5 }", "expected": {"results": [{"signal": 1, "reason": "r", "checks": {"a": true, "b": false}, "stop": 1.5}, {"signal": 1, "reason": "r", "checks": {"a": true, "b": false}, "stop": 1.5}]}},
    {"id": "stock.strategy.002", "description": "A signal object without signal", "spec": "../../docs/standards/stock/README.md#strategy-context", "context": {"type": "Strategy", "candles": [{"open": 0.5, "high": 1.5, "low": 0, "close": 1, "time": 0}, {"open": 1.5, "high": 2.5, "low": 1, "close": 2, "time": 900000}]}, "formula": "{ reason: \"r\" }", "expected": {"results": [{"$error": "OPERATION_ERROR"}, {"$error": "OPERATION_ERROR"}]}},
    {"id": "stock.strategy.003", "description": "A signal that is not a Number", "spec": "../../docs/standards/stock/README.md#strategy-context", "context": {"type": "Strategy", "candles": [{"open": 0.5, "high": 1.5, "low": 0, "close": 1, "time": 0}, {"open": 1.5, "high": 2.5, "low": 1, "close": 2, "time": 900000}]}, "formula": "{ signal: \"1\" }", "expected": {"results": [{"$error": "OPERATION_ERROR"}, {"$error": "OPERATION_ERROR"}]}},
    {"id": "stock.strategy.004", "description": "checks with a value that is not a Boolean", "spec": "../../docs/standards/stock/README.md#strategy-context", "context": {"type": "Strategy", "candles": [{"open": 0.5, "high": 1.5, "low": 0, "close": 1, "time": 0}, {"open": 1.5, "high": 2.5, "low": 1, "close": 2, "time": 900000}]}, "formula": "{ signal: 0, checks: { a: 1 } }", "expected": {"results": [{"$error": "OPERATION_ERROR"}, {"$error": "OPERATION_ERROR"}]}},
    {"id": "stock.strategy.005", "description": "A reason that is not a Text", "spec": "../../docs/standards/stock/README.md#strategy-context", "context": {"type": "Strategy", "candles": [{"open": 0.5, "high": 1.5, "low": 0, "close": 1, "time": 0}, {"open": 1.5, "high": 2.5, "low": 1, "close": 2, "time": 900000}]}, "formula": "{ signal: 0, reason: 1 }", "expected": {"results": [{"$error": "OPERATION_ERROR"}, {"$error": "OPERATION_ERROR"}]}},
    {"id": "stock.functions.SCORE.001", "description": "SCORE of an Object", "spec": "../../docs/standards/stock/functions/SCORE.md", "context": {"type": "Default"}, "formula": "SCORE({ a: true, b: false, c: true, d: true })", "expected": {"result": 0.75}},
    {"id": "stock.functions.SCORE.002", "description": "SCORE of an Array: 5 of 7", "spec": "../../docs/standards/stock/functions/SCORE.md", "context": {"type": "Default"}, "formula": "SCORE([true, true, true, true, true, false, false])", "expected": {"result": 0.7142857142857143}},
    {"id": "stock.functions.SCORE.003", "description": "SCORE of an empty Object", "spec": "../../docs/standards/stock/functions/SCORE.md", "context": {"type": "Default"}, "formula": "SCORE({ })", "expected": {"result": 0}},
    {"id": "stock.functions.SCORE.004", "description": "SCORE of an empty Array", "spec": "../../docs/standards/stock/functions/SCORE.md", "context": {"type": "Default"}, "formula": "SCORE([])", "expected": {"result": 0}},
    {"id": "stock.functions.SCORE.005", "description": "SCORE with a value that is not a Boolean", "spec": "../../docs/standards/stock/functions/SCORE.md", "context": {"type": "Default"}, "formula": "SCORE({ a: true, b: 1 })", "expected": {"error": {"code": "ARGUMENT_ERROR"}}},
    {"id": "stock.functions.SCORE.006", "description": "SCORE with weights; a condition without a weight counts once", "spec": "../../docs/standards/stock/functions/SCORE.md#overload-3-object-with-weights", "context": {"type": "Default"}, "formula": "SCORE({ trend: true, momentum: false, cross: true }, { trend: 2 })", "expected": {"result": 0.75}},
    {"id": "stock.functions.SCORE.007", "description": "SCORE with weights when the heavy condition is false", "spec": "../../docs/standards/stock/functions/SCORE.md#overload-3-object-with-weights", "context": {"type": "Default"}, "formula": "SCORE({ trend: false, momentum: true, cross: true }, { trend: 2 })", "expected": {"result": 0.5}},
    {"id": "stock.functions.SCORE.008", "description": "A weight of 0 does not count", "spec": "../../docs/standards/stock/functions/SCORE.md#overload-3-object-with-weights", "context": {"type": "Default"}, "formula": "SCORE({ a: true, b: false }, { a: 0 })", "expected": {"result": 0}},
    {"id": "stock.functions.SCORE.009", "description": "The sum of the weights is 0", "spec": "../../docs/standards/stock/functions/SCORE.md#overload-3-object-with-weights", "context": {"type": "Default"}, "formula": "SCORE({ a: true, b: false }, { a: 0, b: 0 })", "expected": {"result": 0}},
    {"id": "stock.functions.SCORE.010", "description": "A weight of a key that is not a condition", "spec": "../../docs/standards/stock/functions/SCORE.md#errors", "context": {"type": "Default"}, "formula": "SCORE({ a: true }, { b: 2 })", "expected": {"error": {"code": "INVALID_KEY_ERROR"}}},
    {"id": "stock.functions.SCORE.011", "description": "A negative weight", "spec": "../../docs/standards/stock/functions/SCORE.md#errors", "context": {"type": "Default"}, "formula": "SCORE({ a: true }, { a: -1 })", "expected": {"error": {"code": "OPERATION_ERROR"}}},
    {"id": "stock.functions.SCORE.012", "description": "A weight that is not a Number", "spec": "../../docs/standards/stock/functions/SCORE.md#errors", "context": {"type": "Default"}, "formula": "SCORE({ a: true }, { a: \"2\" })", "expected": {"error": {"code": "ARGUMENT_ERROR"}}},
    {"id": "stock.functions.SCORE.013", "description": "SCORE of an Array with weights", "spec": "../../docs/standards/stock/functions/SCORE.md#overload-4-array-with-weights", "context": {"type": "Default"}, "formula": "SCORE([true, false, true], [3, 1, 1])", "expected": {"result": 0.8}},
    {"id": "stock.functions.SCORE.014", "description": "Arrays of conditions and weights of different lengths", "spec": "../../docs/standards/stock/functions/SCORE.md#errors", "context": {"type": "Default"}, "formula": "SCORE([true, false], [1])", "expected": {"error": {"code": "OPERATION_ERROR"}}},
    {"id": "stock.functions.READY.001", "description": "READY of 2 values", "spec": "../../docs/standards/stock/functions/READY.md", "formula": "READY([null, null, 3, 4, 5, 6, 7, 8], 2)", "expected": {"results": [false, false, false, true, true, true, true, true]}},
    {"id": "stock.functions.READY.002", "description": "READY with n less than 1", "spec": "../../docs/standards/stock/functions/READY.md#errors", "formula": "READY(CLOSE, 0)", "expected": {"results": [{"$error": "OPERATION_ERROR"}, {"$error": "OPERATION_ERROR"}, {"$error": "OPERATION_ERROR"}, {"$error": "OPERATION_ERROR"}, {"$error": "OPERATION_ERROR"}, {"$error": "OPERATION_ERROR"}, {"$error": "OPERATION_ERROR"}, {"$error": "OPERATION_ERROR"}]}},
    {"id": "stock.functions.READY.003", "description": "A series functions outside of a Stock Context", "spec": "../../docs/standards/stock/functions/README.md#series-functions", "context": {"type": "Default"}, "formula": "READY([1], 1)", "expected": {"error": {"code": "OPERATION_ERROR"}}},
    {"id": "stock.functions.READY.004", "description": "A series with a wrong length", "spec": "../../docs/standards/stock/functions/README.md#series-functions", "formula": "READY([1, 2], 1)", "expected": {"results": [{"$error": "OPERATION_ERROR"}, {"$error": "OPERATION_ERROR"}, {"$error": "OPERATION_ERROR"}, {"$error": "OPERATION_ERROR"}, {"$error": "OPERATION_ERROR"}, {"$error": "OPERATION_ERROR"}, {"$error": "OPERATION_ERROR"}, {"$error": "OPERATION_ERROR"}]}},
    {"id": "stock.functions.CROSSOVER.001", "description": "CROSSOVER of a series and a number", "spec": "../../docs/standards/stock/functions/CROSSOVER.md", "formula": "CROSSOVER([1, 2, 4, 5, 3, 6, 6, 6], 3)", "expected": {"results": [false, false, true, false, false, true, false, false]}},
    {"id": "stock.functions.CROSSOVER.002", "description": "CROSSOVER of two series", "spec": "../../docs/standards/stock/functions/CROSSOVER.md", "formula": "CROSSOVER([1, 2, 4, 5, 5, 5, 5, 5], [3, 2, 3, 3, 3, 3, 3, 6])", "expected": {"results": [false, false, true, false, false, false, false, false]}},
    {"id": "stock.functions.CROSSOVER.003", "description": "CROSSOVER with a null value is false", "spec": "../../docs/standards/stock/functions/CROSSOVER.md", "formula": "CROSSOVER([null, 1, 5, 5, 5, 5, 5, 5], 3)", "expected": {"results": [false, false, true, false, false, false, false, false]}},
    {"id": "stock.functions.CROSSOVER.004", "description": "CROSSOVER of two numbers matches no overload", "spec": "../../docs/standards/stock/functions/CROSSOVER.md#errors", "formula": "CROSSOVER(1, 2)", "expected": {"results": [{"$error": "ARGUMENT_ERROR"}, {"$error": "ARGUMENT_ERROR"}, {"$error": "ARGUMENT_ERROR"}, {"$error": "ARGUMENT_ERROR"}, {"$error": "ARGUMENT_ERROR"}, {"$error": "ARGUMENT_ERROR"}, {"$error": "ARGUMENT_ERROR"}, {"$error": "ARGUMENT_ERROR"}]}},
    {"id": "stock.functions.CROSSUNDER.001", "description": "CROSSUNDER of a series and a number", "spec": "../../docs/standards/stock/functions/CROSSUNDER.md", "formula": "CROSSUNDER([1, 2, 4, 5, 3, 6, 6, 6], 4)", "expected": {"results": [false, false, false, false, true, false, false, false]}},
    {"id": "stock.functions.HIGHEST.001", "description": "HIGHEST of 3 values", "spec": "../../docs/standards/stock/functions/HIGHEST.md", "formula": "HIGHEST(CLOSE, 3)", "expected": {"results": [null, null, 3, 4, 5, 6, 7, 8]}},
    {"id": "stock.functions.HIGHEST.002", "description": "HIGHEST with an offset", "spec": "../../docs/standards/stock/functions/HIGHEST.md", "formula": "HIGHEST(CLOSE, 3, 1)", "expected": {"results": [null, null, null, 3, 4, 5, 6, 7]}},
    {"id": "stock.functions.HIGHEST.003", "description": "HIGHEST skips null values", "spec": "../../docs/standards/stock/functions/HIGHEST.md", "formula": "HIGHEST([null, null, null, 1, null, null, null, null], 2)", "expected": {"results": [null, null, null, 1, 1, null, null, null]}},
    {"id": "stock.functions.HIGHEST.004", "description": "HIGHEST with a length less than 1", "spec": "../../docs/standards/stock/functions/HIGHEST.md#errors", "formula": "HIGHEST(CLOSE, 0)", "expected": {"results": [{"$error": "OPERATION_ERROR"}, {"$error": "OPERATION_ERROR"}, {"$error": "OPERATION_ERROR"}, {"$error": "OPERATION_ERROR"}, {"$error": "OPERATION_ERROR"}, {"$error": "OPERATION_ERROR"}, {"$error": "OPERATION_ERROR"}, {"$error": "OPERATION_ERROR"}]}},
    {"id": "stock.functions.LOWEST.001", "description": "LOWEST of 2 values", "spec": "../../docs/standards/stock/functions/LOWEST.md", "formula": "LOWEST(CLOSE, 2)", "expected": {"results": [null, 1, 2, 3, 4, 5, 6, 7]}},
    {"id": "stock.functions.RISING.001", "description": "RISING of 2 candles", "spec": "../../docs/standards/stock/functions/RISING.md", "formula": "RISING(CLOSE, 2)", "expected": {"results": [false, false, true, true, true, true, true, true]}},
    {"id": "stock.functions.RISING.002", "description": "Equal values are not a rise", "spec": "../../docs/standards/stock/functions/RISING.md", "formula": "RISING([1, 2, 2, 3, 4, 5, 6, 7], 1)", "expected": {"results": [false, true, false, true, true, true, true, true]}},
    {"id": "stock.functions.FALLING.001", "description": "FALLING of a rising series", "spec": "../../docs/standards/stock/functions/FALLING.md", "formula": "FALLING(CLOSE, 1)", "expected": {"results": [false, false, false, false, false, false, false, false]}},
    {"id": "stock.functions.FALLING.002", "description": "FALLING of 2 candles", "spec": "../../docs/standards/stock/functions/FALLING.md", "formula": "FALLING([8, 7, 6, 6, 5, 4, 3, 2], 2)", "expected": {"results": [false, false, true, false, false, true, true, true]}},
    {"id": "stock.functions.BARS_SINCE.001", "description": "BARS_SINCE of a condition", "spec": "../../docs/standards/stock/functions/BARS_SINCE.md", "formula": "BARS_SINCE([false, true, false, false, true, false, false, false])", "expected": {"results": [null, 0, 1, 2, 0, 1, 2, 3]}},
    {"id": "stock.functions.BARS_SINCE.002", "description": "BARS_SINCE with an element that is not a Boolean", "spec": "../../docs/standards/stock/functions/BARS_SINCE.md#errors", "formula": "BARS_SINCE([true, 1, false, false, false, false, false, false])", "expected": {"results": [0, {"$error": "OPERATION_ERROR"}, {"$error": "OPERATION_ERROR"}, {"$error": "OPERATION_ERROR"}, {"$error": "OPERATION_ERROR"}, {"$error": "OPERATION_ERROR"}, {"$error": "OPERATION_ERROR"}, {"$error": "OPERATION_ERROR"}]}},
    {"id": "stock.functions.VALUE_WHEN.001", "description": "VALUE_WHEN of the last occurrence", "spec": "../../docs/standards/stock/functions/VALUE_WHEN.md", "formula": "VALUE_WHEN([false, true, false, false, true, false, false, false], CLOSE)", "expected": {"results": [null, 2, 2, 2, 5, 5, 5, 5]}},
    {"id": "stock.functions.VALUE_WHEN.002", "description": "VALUE_WHEN of an earlier occurrence", "spec": "../../docs/standards/stock/functions/VALUE_WHEN.md", "formula": "VALUE_WHEN([false, true, false, false, true, false, false, false], CLOSE, 1)", "expected": {"results": [null, null, null, null, 2, 2, 2, 2]}},
    {"id": "stock.functions.LOAD_INDICATOR.008", "description": "Options without a timeframe are the same as the overload 2", "spec": "../../docs/standards/stock/functions/LOAD_INDICATOR.md#overload-4-options", "formula": "LOAD_INDICATOR(\"SMA2\", { }, { })[I]", "expected": {"results": [null, 1.5, 2.5, 3.5, 4.5, 5.5, 6.5, 7.5]}},
    {"id": "stock.functions.LOAD_INDICATOR.009", "description": "The source option", "spec": "../../docs/standards/stock/functions/LOAD_INDICATOR.md#overload-4-options", "formula": "LOAD_INDICATOR(\"SMA2\", { }, { source: [2, 4, 6, 8, 10, 12, 14, 16] })[I]", "expected": {"results": [null, 3, 5, 7, 9, 11, 13, 15]}},
    {"id": "stock.functions.LOAD_INDICATOR.010", "description": "The output option takes one key of Object results", "spec": "../../docs/standards/stock/functions/LOAD_INDICATOR.md#overload-4-options", "formula": "LOAD_INDICATOR(\"PAIR\", { }, { output: \"b\" })[I]", "expected": {"results": [2, 4, 6, 8, 10, 12, 14, 16]}},
    {"id": "stock.functions.LOAD_INDICATOR.011", "description": "The output option keeps null results", "spec": "../../docs/standards/stock/functions/LOAD_INDICATOR.md#overload-4-options", "formula": "LOAD_INDICATOR(\"LATE\", { }, { output: \"a\" })[I]", "expected": {"results": [null, 2, 3, 4, 5, 6, 7, 8]}},
    {"id": "stock.functions.LOAD_INDICATOR.012", "description": "The output value of an indicator with Number results", "spec": "../../docs/standards/stock/functions/LOAD_INDICATOR.md#overload-4-options", "formula": "LOAD_INDICATOR(\"SMA2\", { }, { output: \"value\" })[I]", "expected": {"results": [null, 1.5, 2.5, 3.5, 4.5, 5.5, 6.5, 7.5]}},
    {"id": "stock.functions.LOAD_INDICATOR.013", "description": "An output that is not a key of the results", "spec": "../../docs/standards/stock/functions/LOAD_INDICATOR.md#overload-4-options", "formula": "LOAD_INDICATOR(\"PAIR\", { }, { output: \"x\" })", "expected": {"results": [{"$error": "INVALID_KEY_ERROR"}, {"$error": "INVALID_KEY_ERROR"}, {"$error": "INVALID_KEY_ERROR"}, {"$error": "INVALID_KEY_ERROR"}, {"$error": "INVALID_KEY_ERROR"}, {"$error": "INVALID_KEY_ERROR"}, {"$error": "INVALID_KEY_ERROR"}, {"$error": "INVALID_KEY_ERROR"}]}},
    {"id": "stock.functions.LOAD_INDICATOR.014", "description": "An unknown option", "spec": "../../docs/standards/stock/functions/LOAD_INDICATOR.md#overload-4-options", "formula": "LOAD_INDICATOR(\"SMA2\", { }, { period: 3 })", "expected": {"results": [{"$error": "ARGUMENT_ERROR"}, {"$error": "ARGUMENT_ERROR"}, {"$error": "ARGUMENT_ERROR"}, {"$error": "ARGUMENT_ERROR"}, {"$error": "ARGUMENT_ERROR"}, {"$error": "ARGUMENT_ERROR"}, {"$error": "ARGUMENT_ERROR"}, {"$error": "ARGUMENT_ERROR"}]}},
    {"id": "stock.functions.LOAD_INDICATOR.015", "description": "An indicator of another timeframe, aligned", "spec": "../../docs/standards/stock/functions/LOAD_INDICATOR.md#overload-4-options", "formula": "LOAD_INDICATOR(\"SMA2\", { }, { timeframe: \"1h\" })[I]", "expected": {"results": [null, null, null, null, null, null, null, 6]}},
    {"id": "stock.functions.LOAD_INDICATOR.016", "description": "The output of an indicator of another timeframe", "spec": "../../docs/standards/stock/functions/LOAD_INDICATOR.md#overload-4-options", "formula": "LOAD_INDICATOR(\"PAIR\", { }, { timeframe: \"1h\", output: \"a\" })[I]", "expected": {"results": [null, null, null, 4, 4, 4, 4, 8]}},
    {"id": "stock.functions.LOAD_INDICATOR.017", "description": "The native series of an indicator of another timeframe", "spec": "../../docs/standards/stock/functions/LOAD_INDICATOR.md#overload-4-options", "formula": "LOAD_INDICATOR(\"SMA2\", { }, { timeframe: \"1h\", align: false })", "expected": {"results": [[], [], [], [null], [null], [null], [null], [null, 6]]}},
    {"id": "stock.functions.LOAD_INDICATOR.018", "description": "A timeframe that the host application does not provide", "spec": "../../docs/standards/stock/functions/LOAD_INDICATOR.md#overload-4-options", "formula": "LOAD_INDICATOR(\"SMA2\", { }, { timeframe: \"1w\" })", "expected": {"results": [{"$error": "NOT_SUPPORTED_ERROR"}, {"$error": "NOT_SUPPORTED_ERROR"}, {"$error": "NOT_SUPPORTED_ERROR"}, {"$error": "NOT_SUPPORTED_ERROR"}, {"$error": "NOT_SUPPORTED_ERROR"}, {"$error": "NOT_SUPPORTED_ERROR"}, {"$error": "NOT_SUPPORTED_ERROR"}, {"$error": "NOT_SUPPORTED_ERROR"}]}},
    {"id": "stock.functions.LOAD_CANDLES.001", "description": "Aligned candles of another timeframe", "spec": "../../docs/standards/stock/functions/LOAD_CANDLES.md", "formula": "IFNULL(LOAD_CANDLES(\"1h\")[I], { close: null }).close", "expected": {"results": [null, null, null, 4, 4, 4, 4, 8]}},
    {"id": "stock.functions.LOAD_CANDLES.002", "description": "Native candles of another timeframe", "spec": "../../docs/standards/stock/functions/LOAD_CANDLES.md", "formula": "LEN(LOAD_CANDLES(\"1h\", { align: false }))", "expected": {"results": [0, 0, 0, 1, 1, 1, 1, 2]}},
    {"id": "stock.functions.LOAD_CANDLES.003", "description": "The last native candle", "spec": "../../docs/standards/stock/functions/LOAD_CANDLES.md", "formula": "IFNULL(LAST(LOAD_CANDLES(\"1h\", { align: false })), { close: null }).close", "expected": {"results": [null, null, null, 4, 4, 4, 4, 8]}},
    {"id": "stock.functions.LOAD_CANDLES.004", "description": "A timeframe that the host application does not provide", "spec": "../../docs/standards/stock/functions/LOAD_CANDLES.md", "formula": "LOAD_CANDLES(\"1w\")", "expected": {"results": [{"$error": "NOT_SUPPORTED_ERROR"}, {"$error": "NOT_SUPPORTED_ERROR"}, {"$error": "NOT_SUPPORTED_ERROR"}, {"$error": "NOT_SUPPORTED_ERROR"}, {"$error": "NOT_SUPPORTED_ERROR"}, {"$error": "NOT_SUPPORTED_ERROR"}, {"$error": "NOT_SUPPORTED_ERROR"}, {"$error": "NOT_SUPPORTED_ERROR"}]}},
    {"id": "stock.functions.LOAD_CANDLES.005", "description": "An unknown option", "spec": "../../docs/standards/stock/functions/LOAD_CANDLES.md", "formula": "LOAD_CANDLES(\"1h\", { x: 1 })", "expected": {"results": [{"$error": "ARGUMENT_ERROR"}, {"$error": "ARGUMENT_ERROR"}, {"$error": "ARGUMENT_ERROR"}, {"$error": "ARGUMENT_ERROR"}, {"$error": "ARGUMENT_ERROR"}, {"$error": "ARGUMENT_ERROR"}, {"$error": "ARGUMENT_ERROR"}, {"$error": "ARGUMENT_ERROR"}]}},
