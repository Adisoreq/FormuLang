{
  "$schema": "../schema.json",
  "description": "Stock 1.3: SCORE with null conditions, SIGNAL_SCORE, and a strategy without warm-up checks.",
  "standards": ["core-1.3", "stock-1.3"],
  "cases": [
    {"id": "stock.stock13.001", "description": "SCORE with a null element", "spec": "../../docs/standards/stock/functions/SCORE.md#overload-2-array", "context": {"type": "Default"}, "formula": "SCORE([true, null])", "expected": {"result": 0.5}},
    {"id": "stock.stock13.002", "description": "SCORE with a null value", "spec": "../../docs/standards/stock/functions/SCORE.md#overload-1-object", "context": {"type": "Default"}, "formula": "SCORE({ a: true, b: null })", "expected": {"result": 0.5}},
    {"id": "stock.stock13.003", "description": "SCORE with weights and a null value", "spec": "../../docs/standards/stock/functions/SCORE.md#overload-3-object-with-weights", "context": {"type": "Default"}, "formula": "SCORE({ a: true, b: null }, { b: 3 })", "expected": {"result": 0.25}},
    {"id": "stock.stock13.004", "description": "SIGNAL_SCORE with all the buy conditions", "spec": "../../docs/standards/stock/functions/SIGNAL_SCORE.md#overload-1", "context": {"type": "Default"}, "formula": "SIGNAL_SCORE({ a: true, b: true }, { c: false, d: false })", "expected": {"result": 1}},
    {"id": "stock.stock13.005", "description": "SIGNAL_SCORE with 1 of 2 buy and 2 of 2 sell conditions", "spec": "../../docs/standards/stock/functions/SIGNAL_SCORE.md#overload-1", "context": {"type": "Default"}, "formula": "SIGNAL_SCORE({ a: true, b: false }, { c: true, d: true })", "expected": {"result": -0.5}},
    {"id": "stock.stock13.006", "description": "SIGNAL_SCORE of Arrays", "spec": "../../docs/standards/stock/functions/SIGNAL_SCORE.md#overload-1", "context": {"type": "Default"}, "formula": "SIGNAL_SCORE([true, true, true, false], [false, false, true, false])", "expected": {"result": 0.5}},
    {"id": "stock.stock13.007", "description": "SIGNAL_SCORE of an Object and an Array", "spec": "../../docs/standards/stock/functions/SIGNAL_SCORE.md#overload-1", "context": {"type": "Default"}, "formula": "SIGNAL_SCORE({ a: true }, [true, false])", "expected": {"result": 0.5}},
    {"id": "stock.stock13.008", "description": "SIGNAL_SCORE with a null condition and no sell conditions", "spec": "../../docs/standards/stock/functions/SIGNAL_SCORE.md#overload-1", "context": {"type": "Default"}, "formula": "SIGNAL_SCORE({ a: true, b: null }, { })", "expected": {"result": 0.5}},
    {"id": "stock.stock13.009", "description": "SIGNAL_SCORE of empty sides", "spec": "../../docs/standards/stock/functions/SIGNAL_SCORE.md#overload-1", "context": {"type": "Default"}, "formula": "SIGNAL_SCORE({ }, { })", "expected": {"result": 0}},
    {"id": "stock.stock13.010", "description": "SIGNAL_SCORE with a condition that is not a Boolean", "spec": "../../docs/standards/stock/functions/SIGNAL_SCORE.md#overload-1", "context": {"type": "Default"}, "formula": "SIGNAL_SCORE({ a: 1 }, { })", "expected": {"error": {"code": "ARGUMENT_ERROR"}}},
    {"id": "stock.stock13.011", "description": "SIGNAL_SCORE with a weight of a buy condition", "spec": "../../docs/standards/stock/functions/SIGNAL_SCORE.md#overload-2-weights", "context": {"type": "Default"}, "formula": "SIGNAL_SCORE({ a: true, b: false }, { c: false }, { a: 3 })", "expected": {"result": 0.75}},
    {"id": "stock.stock13.012", "description": "SIGNAL_SCORE with weights of both sides", "spec": "../../docs/standards/stock/functions/SIGNAL_SCORE.md#overload-2-weights", "context": {"type": "Default"}, "formula": "SIGNAL_SCORE({ a: true, b: false }, { c: true, d: false }, { a: 3, d: 3 })", "expected": {"result": 0.5}},
    {"id": "stock.stock13.013", "description": "SIGNAL_SCORE with a key of both sides: the same weight on both sides", "spec": "../../docs/standards/stock/functions/SIGNAL_SCORE.md#overload-2-weights", "context": {"type": "Default"}, "formula": "SIGNAL_SCORE({ trend: true }, { trend: false, rsi: true }, { trend: 2 })", "expected": {"result": 0.6666666666666667}},
    {"id": "stock.stock13.014", "description": "SIGNAL_SCORE with a weight of an unknown key", "spec": "../../docs/standards/stock/functions/SIGNAL_SCORE.md#overload-2-weights", "context": {"type": "Default"}, "formula": "SIGNAL_SCORE({ a: true }, { b: false }, { c: 2 })", "expected": {"error": {"code": "INVALID_KEY_ERROR"}}},
    {"id": "stock.stock13.015", "description": "SIGNAL_SCORE with a negative weight", "spec": "../../docs/standards/stock/functions/SIGNAL_SCORE.md#overload-2-weights", "context": {"type": "Default"}, "formula": "SIGNAL_SCORE({ a: true }, { b: false }, { a: -1 })", "expected": {"error": {"code": "OPERATION_ERROR"}}},
    {"id": "stock.stock13.016", "description": "SIGNAL_SCORE with weights of Arrays matches no overload", "spec": "../../docs/standards/stock/functions/SIGNAL_SCORE.md#overload-2-weights", "context": {"type": "Default"}, "formula": "SIGNAL_SCORE([true], [false], { a: 1 })", "expected": {"error": {"code": "ARGUMENT_ERROR"}}},
    {"id": "stock.stock13.017", "description": "SIGNAL_SCORE as the signal of a signal object", "spec": "../../docs/standards/stock/README.md#signal-object", "context": {"type": "Strategy", "candles": [{"open": 0.5, "high": 1.5, "low": 0, "close": 1, "time": 0}]}, "formula": "{ signal: SIGNAL_SCORE({ a: true }, { b: false }), checks: MERGE({ a: true }, { b: false }) }", "expected": {"results": [{"signal": 1, "checks": {"a": true, "b": false}}]}},
    {"id": "stock.stock13.018", "description": "An Object without signal is still an Error", "spec": "../../docs/standards/stock/README.md#signal-object", "context": {"type": "Strategy", "candles": [{"open": 0.5, "high": 1.5, "low": 0, "close": 1, "time": 0}]}, "formula": "{ buy: { a: true } }", "expected": {"results": [{"$error": "OPERATION_ERROR"}]}},
    {"id": "stock.stock13.019", "description": "A strategy without warm-up checks: no condition is met while the indicator and the previous candle are missing", "spec": "../../docs/standards/core/README.md#missing-values", "context": {"type": "Strategy", "candles": [{"open": 0.5, "high": 1.5, "low": 0, "close": 1, "time": 0}, {"open": 1.5, "high": 2.5, "low": 1, "close": 2, "time": 900000}, {"open": 2.5, "high": 3.5, "low": 2, "close": 3, "time": 1800000}]}, "registry": {"indicators": [{"id": "SMA2", "formula": "WINDOW(SOURCE, 2, AVG)"}]}, "formula": ["$sma = LOAD_INDICATOR(\"SMA2\")", "$prev = GET(CLOSE, I - 1, null)", "$buy = { above: CLOSE[I] > $sma[I], up: CLOSE[I] > $prev }", "$sell = { below: CLOSE[I] < $sma[I], down: CLOSE[I] < $prev }", "{ signal: SIGNAL_SCORE($buy, $sell), checks: MERGE($buy, $sell) }"], "expected": {"results": [{"signal": 0, "checks": {"above": false, "up": false, "below": false, "down": false}}, {"signal": 1, "checks": {"above": true, "up": true, "below": false, "down": false}}, {"signal": 1, "checks": {"above": true, "up": true, "below": false, "down": false}}]}}
  ]
}
