{
  "$schema": "../../schema.json",
  "description": "Core 1.2: HISTORY and the memory (STORE, RECALL, CLEAR) of the Iteration and Time Contexts.",
  "standards": ["core-1.2"],
  "defaults": {"context": {"type": "Iteration", "n": 4}},
  "cases": [
    {"id": "core.context.core12.001", "description": "HISTORY has one element for every previous iteration", "spec": "../../../docs/core/context.md#2-iteration-context", "formula": "LEN(HISTORY)", "expected": {"results": [0, 1, 2, 3]}},
    {"id": "core.context.core12.002", "description": "HISTORY holds the results of all the previous iterations", "spec": "../../../docs/core/context.md#2-iteration-context", "formula": "SUM(HISTORY) + I", "expected": {"results": [0, 1, 3, 7]}},
    {"id": "core.context.core12.003", "description": "The last element of HISTORY is PREV", "spec": "../../../docs/core/context.md#2-iteration-context", "formula": "IF(LEN(HISTORY) == 0, true, LAST(HISTORY) == PREV)", "expected": {"results": [true, true, true, true]}},
    {"id": "core.context.core12.004", "description": "HISTORY follows @array_indexing", "spec": "../../../docs/core/context.md#2-iteration-context", "environment": {"variables": {"array_indexing": 1}}, "formula": "IF(I == 1, 10, HISTORY[I - 1] + 1)", "expected": {"results": [10, 11, 12, 13]}},
    {"id": "core.context.core12.005", "description": "A sum kept in the memory", "spec": "../../../docs/core/context.md#memory", "formula": ["$sum = RECALL(\"sum\", 0) + I", "STORE(\"sum\", $sum)", "$sum"], "expected": {"results": [0, 1, 3, 6]}},
    {"id": "core.context.core12.006", "description": "A write is visible from the next iteration", "spec": "../../../docs/core/context.md#memory", "formula": ["STORE(\"x\", I)", "RECALL(\"x\")"], "expected": {"results": [null, 0, 1, 2]}},
    {"id": "core.context.core12.007", "description": "The last write of a key wins", "spec": "../../../docs/core/context.md#memory", "formula": ["STORE(\"x\", 1)", "STORE(\"x\", 2)", "RECALL(\"x\")"], "expected": {"results": [null, 2, 2, 2]}},
    {"id": "core.context.core12.008", "description": "RECALL with a fallback", "spec": "../../../docs/standards/core/functions/RECALL.md", "formula": ["STORE(\"x\", I * 10)", "RECALL(\"x\", -1)"], "expected": {"results": [-1, 0, 10, 20]}},
    {"id": "core.context.core12.009", "description": "A write in the branch of IF that is not selected is discarded", "spec": "../../../docs/core/context.md#memory", "formula": ["IF(I == 1, STORE(\"x\", I), 0)", "RECALL(\"x\")"], "expected": {"results": [null, null, 1, 1]}},
    {"id": "core.context.core12.010", "description": "A write in an argument of OR that does not decide the result is discarded", "spec": "../../../docs/core/context.md#memory", "formula": ["$prev = RECALL(\"x\")", "$t = I == 1 || ISERR(STORE(\"x\", I))", "$prev"], "expected": {"results": [null, 0, 0, 2]}},
    {"id": "core.context.core12.011", "description": "The writes of an iteration that results in an Error are discarded", "spec": "../../../docs/core/context.md#memory", "formula": ["STORE(\"x\", I)", "IF(I == 1, ERROR(\"e\"), RECALL(\"x\"))"], "expected": {"results": [null, {"$error": "CUSTOM_ERROR"}, 0, 2]}},
    {"id": "core.context.core12.012", "description": "CLEAR removes a key", "spec": "../../../docs/standards/core/procedures/CLEAR.md", "formula": ["STORE(\"x\", I)", "IF(I == 1, CLEAR(\"x\"), 0)", "RECALL(\"x\")"], "expected": {"results": [null, 0, null, 2]}},
    {"id": "core.context.core12.013", "description": "A STORE after CLEAR() in the same iteration is kept", "spec": "../../../docs/standards/core/procedures/CLEAR.md", "formula": ["IF(I == 2, CLEAR(), 0)", "$c = RECALL(\"c\", 0) + 1", "STORE(\"c\", $c)", "$c"], "expected": {"results": [1, 2, 3, 4]}},
    {"id": "core.context.core12.014", "description": "CLEAR() removes every key", "spec": "../../../docs/standards/core/procedures/CLEAR.md", "formula": ["STORE(\"a\", 1)", "STORE(\"b\", 2)", "IF(I == 1, CLEAR(), 0)", "[RECALL(\"a\"), RECALL(\"b\")]"], "expected": {"results": [[null, null], [1, 2], [null, null], [1, 2]]}},
    {"id": "core.context.core12.015", "description": "A value of the memory can be an Array or an Object", "spec": "../../../docs/standards/core/procedures/STORE.md", "formula": ["STORE(\"v\", { n: I, list: [I] })", "RECALL(\"v\")"], "expected": {"results": [null, {"n": 0, "list": [0]}, {"n": 1, "list": [1]}, {"n": 2, "list": [2]}]}},
    {"id": "core.context.core12.016", "description": "STORE with a key that is not a Text", "spec": "../../../docs/standards/core/procedures/STORE.md#errors", "formula": "STORE(1, 1)", "expected": {"results": [{"$error": "ARGUMENT_ERROR"}, {"$error": "ARGUMENT_ERROR"}, {"$error": "ARGUMENT_ERROR"}, {"$error": "ARGUMENT_ERROR"}]}},
    {"id": "core.context.core12.017", "description": "STORE with a Delegate value", "spec": "../../../docs/standards/core/procedures/STORE.md#errors", "formula": "STORE(\"f\", (x) => x)", "expected": {"results": [{"$error": "ARGUMENT_ERROR"}, {"$error": "ARGUMENT_ERROR"}, {"$error": "ARGUMENT_ERROR"}, {"$error": "ARGUMENT_ERROR"}]}},
    {"id": "core.context.core12.018", "description": "STORE called without parentheses", "spec": "../../../docs/standards/core/procedures/STORE.md", "formula": ["STORE \"x\" I", "RECALL(\"x\", -1)"], "expected": {"results": [-1, 0, 1, 2]}},
    {"id": "core.context.core12.019", "description": "The memory of a Time Context", "spec": "../../../docs/core/context.md#memory", "context": {"type": "Time", "frames": [{"time_s": 0, "dtime_s": 0}, {"time_s": 0.5, "dtime_s": 0.5}, {"time_s": 1, "dtime_s": 0.5}]}, "formula": ["$c = RECALL(\"c\", 0) + 1", "STORE(\"c\", $c)", "$c"], "expected": {"results": [1, 2, 3]}}
  ]
}
