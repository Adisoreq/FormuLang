{
  "$schema": "../../schema.json",
  "description": "Basic Core functions and operators. Values follow the examples and algorithms of docs/standards/core/functions.",
  "standards": ["core-1.0"],
  "cases": [
    { "id": "core.functions.basics.001", "description": "Operator precedence", "formula": "2 + 3 * 4", "expected": { "result": 14 } },
    { "id": "core.functions.basics.002", "description": "Parentheses", "formula": "(2 + 3) * 4", "expected": { "result": 20 } },
    { "id": "core.functions.basics.003", "description": "Number notations", "formula": "[1_000, .5, 1.2E+3, 0xFF]", "expected": { "result": [1000, 0.5, 1200, 255] } },
    { "id": "core.functions.basics.004", "description": "MOD has the sign of the dividend", "formula": "MOD(-7, 3)", "expected": { "result": -1 } },
    { "id": "core.functions.basics.005", "description": "Division by zero", "formula": "DIV(1, 0)", "expected": { "error": { "code": "OPERATION_ERROR" } } },
    { "id": "core.functions.basics.006", "description": "ROUND rounds half away from zero", "formula": "[ROUND(2.5, 0), ROUND(-2.5, 0)]", "expected": { "result": [3, -3] } },
    { "id": "core.functions.basics.007", "description": "SUM and PROD of an empty array", "formula": "[SUM([]), PROD([])]", "expected": { "result": [0, 1] } },
    { "id": "core.functions.basics.008", "description": "AVG of an empty array", "formula": "AVG([])", "expected": { "error": { "code": "OPERATION_ERROR" } } },
    { "id": "core.functions.basics.009", "description": "+ joins texts", "formula": "\"Hello, \" + \"world!\"", "expected": { "result": "Hello, world!" } },
    { "id": "core.functions.basics.010", "description": "Escape sequences", "formula": "\"a\\tb\\n\\\"c\\\"\\\\\"", "expected": { "result": "a\tb\n\"c\"\\" } },
    { "id": "core.functions.basics.011", "description": "Array index follows @array_indexing (0)", "formula": "[5, 6, 7][2]", "expected": { "result": 7 } },
    { "id": "core.functions.basics.012", "description": "Array index follows @array_indexing (1)", "environment": { "variables": { "array_indexing": 1 } }, "formula": "[5, 6, 7][2]", "expected": { "result": 6 } },
    { "id": "core.functions.basics.013", "description": "Index outside of the array", "formula": "[5, 6, 7][3]", "expected": { "error": { "code": "INVALID_INDEX_ERROR" } } },
    { "id": "core.functions.basics.014", "description": "Object access", "formula": ["$obj = { name: \"John\", age: 24 }", "[$obj.name, $obj[\"age\"]]"], "expected": { "result": ["John", 24] } },
    { "id": "core.functions.basics.015", "description": "Missing key", "formula": "{ a: 1 }.b", "expected": { "error": { "code": "INVALID_KEY_ERROR" } } },
    { "id": "core.functions.basics.016", "description": "Lambda and FILTER", "formula": "FILTER([5, 6, 7, 8, 9], (n) => MOD(n, 3) == 0)", "expected": { "result": [6, 9] } },
    { "id": "core.functions.basics.017", "description": "MAP with the index", "formula": "MAP([10, 20], (e, i) => e + i)", "expected": { "result": [10, 21] } },
    { "id": "core.functions.basics.018", "description": "REDUCE", "formula": "REDUCE([1, 2, 3, 4], (acc, e) => acc + e, 0)", "expected": { "result": 10 } },
    { "id": "core.functions.basics.019", "description": "RANGE includes the last index", "formula": "RANGE([1, 2, 3, 4, 5], 1, 3)", "expected": { "result": [2, 3, 4] } },
    { "id": "core.functions.basics.020", "description": "SORT is stable and orders texts by code points", "formula": "SORT([\"b\", \"B\", \"a\"])", "expected": { "result": ["B", "a", "b"] } },
    { "id": "core.functions.basics.021", "description": "SUBSTR and FIND", "formula": "[SUBSTR(\"abcdef\", 2, 3), FIND(\"abc\", \"c\"), FIND(\"abc\", \"z\")]", "expected": { "result": ["cde", 2, null] } },
    { "id": "core.functions.basics.022", "description": "IF discards the branch that is not selected, even an Error", "formula": "IF(true, 1, DIV(1, 0))", "expected": { "result": 1 } },
    { "id": "core.functions.basics.023", "description": "ISERR receives an Error as a value", "formula": "ISERR(ERROR(\"x\"))", "expected": { "result": true } },
    { "id": "core.functions.basics.024", "description": "An unhandled Error aborts the execution", "formula": ["ERROR(\"stop\")", "1"], "expected": { "error": { "code": "CUSTOM_ERROR" } } },
    { "id": "core.functions.basics.025", "description": "suppress_errors turns an unhandled Error into null", "environment": { "variables": { "suppress_errors": true } }, "formula": ["ERROR(\"skip\")", "1"], "expected": { "result": 1 } },
    { "id": "core.functions.basics.026", "description": "Arrays are compared by value", "formula": "[1, [2, 3]] == [1, [2, 3]]", "expected": { "result": true } },
    { "id": "core.functions.basics.027", "description": "KEYS keeps the order of definition", "formula": "KEYS({ b: 1, a: 2 })", "expected": { "result": ["b", "a"] } },
    { "id": "core.functions.basics.028", "description": "Reading an unknown context variable", "formula": "$nope + 1", "expected": { "error": { "code": "UNKNOWN_SYMBOL_ERROR" } } },
    { "id": "core.functions.basics.029", "description": "Initial assignment does not override a value", "formula": ["$x = 1", "$x := 2", "$x"], "expected": { "result": 1 } },
    { "id": "core.functions.basics.030", "description": "Trigonometry and constants", "formula": "[ROUND(SIN(PI / 2), 6), DEG(PI)]", "expected": { "result": [1, 180] } },
    { "id": "core.functions.basics.031", "description": "IF does not convert a condition that is not a Boolean", "formula": "IF(1, 2, 3)", "expected": { "error": { "code": "ARGUMENT_ERROR" } } },
    { "id": "core.functions.basics.032", "description": "IF with a condition converted by BOOL", "formula": "IF(BOOL(1), 2, 3)", "expected": { "result": 2 } },
    { "id": "core.functions.basics.033", "description": "IF that matches no overload returns the leftmost Error argument: the condition", "formula": "IF(ERROR(\"c\"), ERROR(\"a\"), 2)", "expected": { "error": { "code": "CUSTOM_ERROR", "message": "c" } } },
    { "id": "core.functions.basics.034", "description": "IF that matches no overload returns the leftmost Error argument: a branch", "formula": "IF(1, ERROR(\"a\"), 2)", "expected": { "error": { "code": "CUSTOM_ERROR", "message": "a" } } }
  ]
}
