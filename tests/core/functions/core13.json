{
  "$schema": "../../schema.json",
  "description": "Core 1.3: missing values (null) in comparisons, arithmetic, aggregates and keys; GET with a fallback; the array and object functions that return a copy; what does not change.",
  "standards": ["core-1.3"],
  "cases": [
    {"id": "core.functions.core13.001", "description": "null > 1 is false", "spec": "../../../docs/standards/core/README.md#missing-values", "formula": "null > 1", "expected": {"result": false}},
    {"id": "core.functions.core13.002", "description": "1 <= null is false", "spec": "../../../docs/standards/core/README.md#missing-values", "formula": "1 <= null", "expected": {"result": false}},
    {"id": "core.functions.core13.003", "description": "null >= null is false", "spec": "../../../docs/standards/core/README.md#missing-values", "formula": "null >= null", "expected": {"result": false}},
    {"id": "core.functions.core13.004", "description": "null < 1 is false", "spec": "../../../docs/standards/core/functions/LES.md#overload-2-missing-values", "formula": "null < 1", "expected": {"result": false}},
    {"id": "core.functions.core13.005", "description": "A comparison and its negation are both false with null", "spec": "../../../docs/standards/core/README.md#missing-values", "formula": "[null > 1, null <= 1, !(null > 1)]", "expected": {"result": [false, false, true]}},
    {"id": "core.functions.core13.006", "description": "null == null is still true", "spec": "../../../docs/standards/core/functions/EQU.md", "formula": "null == null", "expected": {"result": true}},
    {"id": "core.functions.core13.007", "description": "null != 1 is still true", "spec": "../../../docs/standards/core/functions/NEQ.md", "formula": "null != 1", "expected": {"result": true}},
    {"id": "core.functions.core13.008", "description": "null compared with a Text matches no overload", "spec": "../../../docs/standards/core/functions/GRE.md", "formula": "null > \"a\"", "expected": {"error": {"code": "ARGUMENT_ERROR"}}},
    {"id": "core.functions.core13.009", "description": "null + 1 is null", "spec": "../../../docs/standards/core/functions/ADD.md#overload-3-missing-values", "formula": "null + 1", "expected": {"result": null}},
    {"id": "core.functions.core13.010", "description": "1 - null is null", "spec": "../../../docs/standards/core/functions/SUB.md#overload-2-missing-values", "formula": "1 - null", "expected": {"result": null}},
    {"id": "core.functions.core13.011", "description": "2 * null is null", "spec": "../../../docs/standards/core/functions/MUL.md#overload-2-missing-values", "formula": "2 * null", "expected": {"result": null}},
    {"id": "core.functions.core13.012", "description": "null / 0 is null", "spec": "../../../docs/standards/core/functions/DIV.md#overload-2-missing-values", "formula": "null / 0", "expected": {"result": null}},
    {"id": "core.functions.core13.013", "description": "-null is null", "spec": "../../../docs/standards/core/functions/NEG.md#overload-2-missing-values", "formula": "-null", "expected": {"result": null}},
    {"id": "core.functions.core13.014", "description": "ABS(null) is null", "spec": "../../../docs/standards/core/functions/ABS.md#overload-2-missing-values", "formula": "ABS(null)", "expected": {"result": null}},
    {"id": "core.functions.core13.015", "description": "A comparison of a null product is false", "spec": "../../../docs/standards/core/README.md#missing-values", "formula": "null * 2 > 0", "expected": {"result": false}},
    {"id": "core.functions.core13.016", "description": "A Text plus null matches no overload", "spec": "../../../docs/standards/core/functions/ADD.md", "formula": "\"a\" + null", "expected": {"error": {"code": "ARGUMENT_ERROR"}}},
    {"id": "core.functions.core13.017", "description": "MIN of an array with null is null", "spec": "../../../docs/standards/core/functions/MIN.md#overload-3", "formula": "MIN([1, null])", "expected": {"result": null}},
    {"id": "core.functions.core13.018", "description": "MAX of an array with null is null", "spec": "../../../docs/standards/core/functions/MAX.md#overload-3", "formula": "MAX([3, null, 5])", "expected": {"result": null}},
    {"id": "core.functions.core13.019", "description": "SUM of an array with null is null", "spec": "../../../docs/standards/core/functions/SUM.md", "formula": "SUM([1, null])", "expected": {"result": null}},
    {"id": "core.functions.core13.020", "description": "AVG of an array with null is null", "spec": "../../../docs/standards/core/functions/AVG.md", "formula": "AVG([1, null])", "expected": {"result": null}},
    {"id": "core.functions.core13.021", "description": "MIN of an empty array is null", "spec": "../../../docs/standards/core/functions/MIN.md#overload-3", "formula": "MIN([])", "expected": {"result": null}},
    {"id": "core.functions.core13.022", "description": "MAX of an empty array is null", "spec": "../../../docs/standards/core/functions/MAX.md#overload-3", "formula": "MAX([])", "expected": {"result": null}},
    {"id": "core.functions.core13.023", "description": "MIN without null does not change", "spec": "../../../docs/standards/core/functions/MIN.md#overload-3", "formula": "MIN([2, 1])", "expected": {"result": 1}},
    {"id": "core.functions.core13.024", "description": "AVG of an empty array is still an OPERATION_ERROR", "spec": "../../../docs/standards/core/functions/AVG.md", "formula": "AVG([])", "expected": {"error": {"code": "OPERATION_ERROR"}}},
    {"id": "core.functions.core13.025", "description": "A handler of MIN that returns null gives null", "spec": "../../../docs/standards/core/functions/MIN.md#overload-4", "formula": "MIN([1, 2], (e) => IF(e == 2, null, e))", "expected": {"result": null}},
    {"id": "core.functions.core13.026", "description": "A key of null is null", "spec": "../../../docs/standards/core/functions/GET.md#overload-3-key-of-a-missing-object", "formula": "null.close", "expected": {"result": null}},
    {"id": "core.functions.core13.027", "description": "A key of a null variable compared is false", "spec": "../../../docs/standards/core/functions/GET.md#overload-3-key-of-a-missing-object", "formula": ["$o = null", "$o.close > 1"], "expected": {"result": false}},
    {"id": "core.functions.core13.028", "description": "An index of null matches no overload", "spec": "../../../docs/standards/core/functions/GET.md#overload-3-key-of-a-missing-object", "formula": "null[0]", "expected": {"error": {"code": "ARGUMENT_ERROR"}}},
    {"id": "core.functions.core13.029", "description": "GET with a fallback for an index after the end", "spec": "../../../docs/standards/core/functions/GET.md#overload-4-array-index-with-a-fallback", "formula": "GET([1, 2], 5, 0)", "expected": {"result": 0}},
    {"id": "core.functions.core13.030", "description": "GET with a fallback for a negative index", "spec": "../../../docs/standards/core/functions/GET.md#overload-4-array-index-with-a-fallback", "formula": "GET([1, 2], -1, null)", "expected": {"result": null}},
    {"id": "core.functions.core13.031", "description": "GET with a fallback for an existing index", "spec": "../../../docs/standards/core/functions/GET.md#overload-4-array-index-with-a-fallback", "formula": "GET([1, 2], 1, 0)", "expected": {"result": 2}},
    {"id": "core.functions.core13.032", "description": "GET with a fallback for an index that is not whole", "spec": "../../../docs/standards/core/functions/GET.md#overload-4-array-index-with-a-fallback", "formula": "GET([1, 2], 0.5, 0)", "expected": {"error": {"code": "INVALID_INDEX_ERROR"}}},
    {"id": "core.functions.core13.033", "description": "An index outside of the array is still an INVALID_INDEX_ERROR", "spec": "../../../docs/standards/core/functions/GET.md#overload-1-array-index", "formula": "[1, 2][5]", "expected": {"error": {"code": "INVALID_INDEX_ERROR"}}},
    {"id": "core.functions.core13.034", "description": "GET with a fallback for a missing key", "spec": "../../../docs/standards/core/functions/GET.md#overload-5-object-key-with-a-fallback", "formula": "GET({ a: 1 }, \"b\", 0)", "expected": {"result": 0}},
    {"id": "core.functions.core13.035", "description": "GET with a fallback for an existing key", "spec": "../../../docs/standards/core/functions/GET.md#overload-5-object-key-with-a-fallback", "formula": "GET({ a: 1 }, \"a\", 0)", "expected": {"result": 1}},
    {"id": "core.functions.core13.036", "description": "MERGE of three objects", "spec": "../../../docs/standards/core/functions/MERGE.md#overload-2", "formula": "MERGE({ a: 1 }, { b: 2 }, { c: 3 })", "expected": {"result": {"a": 1, "b": 2, "c": 3}}},
    {"id": "core.functions.core13.037", "description": "MERGE of many objects: the last value wins, the first position stays", "spec": "../../../docs/standards/core/functions/MERGE.md#overload-2", "formula": "MERGE({ a: 1, b: 1 }, { b: 2 }, { a: 3 })", "expected": {"result": {"a": 3, "b": 2}}},
    {"id": "core.functions.core13.038", "description": "CONCAT of two arrays", "spec": "../../../docs/standards/core/functions/CONCAT.md#overload-2-arrays", "formula": "CONCAT([1, 2], [3])", "expected": {"result": [1, 2, 3]}},
    {"id": "core.functions.core13.039", "description": "The operator + does not join arrays", "spec": "../../../docs/standards/core/functions/CONCAT.md#overload-2-arrays", "formula": "[1] + [2]", "expected": {"error": {"code": "ARGUMENT_ERROR"}}},
    {"id": "core.functions.core13.040", "description": "APPEND a value", "spec": "../../../docs/standards/core/functions/APPEND.md", "formula": "APPEND([1, 2], 3)", "expected": {"result": [1, 2, 3]}},
    {"id": "core.functions.core13.041", "description": "APPEND an array as one element", "spec": "../../../docs/standards/core/functions/APPEND.md", "formula": "APPEND([1], [2])", "expected": {"result": [1, [2]]}},
    {"id": "core.functions.core13.042", "description": "APPEND does not change its argument", "spec": "../../../docs/standards/core/functions/APPEND.md", "formula": ["$a = [1]", "$b = APPEND($a, 2)", "[$a, $b]"], "expected": {"result": [[1], [1, 2]]}},
    {"id": "core.functions.core13.043", "description": "INSERT in the middle", "spec": "../../../docs/standards/core/functions/INSERT.md", "formula": "INSERT([1, 3], 1, 2)", "expected": {"result": [1, 2, 3]}},
    {"id": "core.functions.core13.044", "description": "INSERT at the length adds at the end", "spec": "../../../docs/standards/core/functions/INSERT.md", "formula": "INSERT([1, 2], 2, 3)", "expected": {"result": [1, 2, 3]}},
    {"id": "core.functions.core13.045", "description": "INSERT after the length", "spec": "../../../docs/standards/core/functions/INSERT.md", "formula": "INSERT([1, 2], 3, 4)", "expected": {"error": {"code": "INVALID_INDEX_ERROR"}}},
    {"id": "core.functions.core13.046", "description": "PUT replaces an element", "spec": "../../../docs/standards/core/functions/PUT.md#overload-1-array-index", "formula": "PUT([1, 2, 3], 1, 9)", "expected": {"result": [1, 9, 3]}},
    {"id": "core.functions.core13.047", "description": "PUT at a missing index", "spec": "../../../docs/standards/core/functions/PUT.md#overload-1-array-index", "formula": "PUT([1, 2], 2, 3)", "expected": {"error": {"code": "INVALID_INDEX_ERROR"}}},
    {"id": "core.functions.core13.048", "description": "REMOVE an element", "spec": "../../../docs/standards/core/functions/REMOVE.md#overload-1-array-index", "formula": "REMOVE([1, 2, 3], 0)", "expected": {"result": [2, 3]}},
    {"id": "core.functions.core13.049", "description": "REMOVE at a missing index", "spec": "../../../docs/standards/core/functions/REMOVE.md#overload-1-array-index", "formula": "REMOVE([1], 5)", "expected": {"error": {"code": "INVALID_INDEX_ERROR"}}},
    {"id": "core.functions.core13.050", "description": "PUT adds a key at the end", "spec": "../../../docs/standards/core/functions/PUT.md#overload-2-object-key", "formula": "PUT({ a: 1 }, \"b\", 2)", "expected": {"result": {"a": 1, "b": 2}}},
    {"id": "core.functions.core13.051", "description": "PUT replaces a key in its place", "spec": "../../../docs/standards/core/functions/PUT.md#overload-2-object-key", "formula": "PUT({ a: 1, b: 2 }, \"a\", 3)", "expected": {"result": {"a": 3, "b": 2}}},
    {"id": "core.functions.core13.052", "description": "PUT with a key that is not an identifier", "spec": "../../../docs/standards/core/functions/PUT.md#overload-2-object-key", "formula": "PUT({ }, \"first name\", 1)", "expected": {"error": {"code": "INVALID_KEY_ERROR"}}},
    {"id": "core.functions.core13.053", "description": "REMOVE a key", "spec": "../../../docs/standards/core/functions/REMOVE.md#overload-2-object-key", "formula": "REMOVE({ a: 1, b: 2 }, \"a\")", "expected": {"result": {"b": 2}}},
    {"id": "core.functions.core13.054", "description": "REMOVE a missing key", "spec": "../../../docs/standards/core/functions/REMOVE.md#overload-2-object-key", "formula": "REMOVE({ a: 1 }, \"b\")", "expected": {"error": {"code": "INVALID_KEY_ERROR"}}},
    {"id": "core.functions.core13.055", "description": "VALUES in the order of the keys", "spec": "../../../docs/standards/core/functions/VALUES.md", "formula": "VALUES({ name: \"Ada\", age: 36 })", "expected": {"result": ["Ada", 36]}},
    {"id": "core.functions.core13.056", "description": "VALUES of an empty object", "spec": "../../../docs/standards/core/functions/VALUES.md", "formula": "VALUES({ })", "expected": {"result": []}},
    {"id": "core.functions.core13.057", "description": "ENTRIES of an object", "spec": "../../../docs/standards/core/functions/ENTRIES.md", "formula": "ENTRIES({ a: 1, b: 2 })", "expected": {"result": [["a", 1], ["b", 2]]}},
    {"id": "core.functions.core13.058", "description": "FROM_ENTRIES of pairs", "spec": "../../../docs/standards/core/functions/FROM_ENTRIES.md", "formula": "FROM_ENTRIES([[\"a\", 1], [\"b\", 2]])", "expected": {"result": {"a": 1, "b": 2}}},
    {"id": "core.functions.core13.059", "description": "FROM_ENTRIES with a repeated key: the last value wins", "spec": "../../../docs/standards/core/functions/FROM_ENTRIES.md", "formula": "FROM_ENTRIES([[\"a\", 1], [\"a\", 2]])", "expected": {"result": {"a": 2}}},
    {"id": "core.functions.core13.060", "description": "FROM_ENTRIES with an element that is not a pair", "spec": "../../../docs/standards/core/functions/FROM_ENTRIES.md", "formula": "FROM_ENTRIES([[\"a\", 1, 2]])", "expected": {"error": {"code": "ARGUMENT_ERROR"}}},
    {"id": "core.functions.core13.061", "description": "FROM_ENTRIES with a key that is not an identifier", "spec": "../../../docs/standards/core/functions/FROM_ENTRIES.md", "formula": "FROM_ENTRIES([[\"first name\", 1]])", "expected": {"error": {"code": "INVALID_KEY_ERROR"}}},
    {"id": "core.functions.core13.062", "description": "NOT(null) is still an ARGUMENT_ERROR", "spec": "../../../docs/standards/core/README.md#missing-values", "formula": "NOT(null)", "expected": {"error": {"code": "ARGUMENT_ERROR"}}},
    {"id": "core.functions.core13.063", "description": "null && true is still an ARGUMENT_ERROR", "spec": "../../../docs/standards/core/README.md#missing-values", "formula": "null && true", "expected": {"error": {"code": "ARGUMENT_ERROR"}}},
    {"id": "core.functions.core13.064", "description": "IF with a null condition is still an ARGUMENT_ERROR", "spec": "../../../docs/standards/core/README.md#missing-values", "formula": "IF(null, 1, 2)", "expected": {"error": {"code": "ARGUMENT_ERROR"}}},
    {"id": "core.functions.core13.065", "description": "IFERR sees the value that was an Error in core-1.2", "spec": "../../../docs/standards/core/README.md#missing-values", "formula": "IFERR(null + 1, 0)", "expected": {"result": null}},
    {"id": "core.functions.core13.066", "description": "ISERR sees the value that was an Error in core-1.2", "spec": "../../../docs/standards/core/README.md#missing-values", "formula": "ISERR(null > 1)", "expected": {"result": false}},
    {"id": "core.functions.core13.067", "description": "INSERT follows array_indexing", "spec": "../../../docs/standards/core/functions/INSERT.md", "environment": {"variables": {"array_indexing": 1}}, "formula": "INSERT([1, 3], 2, 2)", "expected": {"result": [1, 2, 3]}}
  ]
}
